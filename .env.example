# 별도로 배포한 API의 HTTPS 기본 주소 (예: https://bluecl.cloud/gongmodu). 로컬에서는 빈 값으로 두면 Vite proxy를 사용해요.
VITE_API_BASE_URL=
# 검토를 마치고 공개한 정책 문서의 HTTPS 주소를 넣으면 앱 하단에 링크가 표시돼요.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
PORT=3001
ALLOWED_ORIGINS=https://gongmodu.apps.tossmini.com,https://gongmodu.private-apps.tossmini.com,https://gongmodu.web.tossmini.com,https://gongmodu.private-web.tossmini.com
# OpenDART 인증키. VITE_ 접두어를 붙이지 않고 서버에서만 사용해요.
DART_API_KEY=
DART_LOOKBACK_DAYS=180

# API와 수집기가 함께 읽는 저장 파일. 우분투에서는 릴리스 폴더 밖 절대 경로를 사용해요.
DART_SNAPSHOT_PATH=.cache/dart-schedule.json
