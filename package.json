{
  "name": "gongmodu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,app \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --include .env --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build": "node --env-file-if-exists=.env scripts/check-release.mjs && npm run build:web && ait build",
    "bundle:preview": "npm run build:web && ait build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "sync:dart": "tsx --env-file-if-exists=.env scripts/sync-dart.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "3.9.0",
    "@emotion/react": "^11.14.0",
    "@toss/tds-mobile": "2.5.1",
    "@toss/tds-mobile-ait": "2.5.1",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "node-ical": "^0.22.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
